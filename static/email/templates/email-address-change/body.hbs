{{> header title="Confirm your new email address" preheader="Confirm this address to finish changing your PetsUpRight login email." }}

<mj-wrapper background-color="#ffffff" border-radius="16px" padding="32px 20px 28px">
  <mj-section>
    <mj-column>
      <mj-text align="center" css-class="h1" font-size="26px" line-height="34px" font-weight="700" color="#2f3150">
        Confirm your new email
      </mj-text>
      <mj-text align="center" padding="12px 0 0" color="#5b5d78">
        We received a request to change your PetsUpRight login email to this address. Confirm it to complete the change.
      </mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="24px 0 0">
    <mj-column>
      <mj-button href="{{ changeEmailAddressUrl }}?token={{ identifierChangeToken }}" css-class="btn-full">
        Confirm new email
      </mj-button>
      <mj-text align="center" padding="16px 0 0" font-size="13px" line-height="20px" color="#7b7d94">
        If you didn't request this change, ignore this email and your login email stays the same.
      </mj-text>
    </mj-column>
  </mj-section>
</mj-wrapper>

{{> footer }}
