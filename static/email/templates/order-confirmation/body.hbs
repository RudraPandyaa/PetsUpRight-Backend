{{> header title="Order Confirmation" }}

<mj-section background-color="#f7f5fa" padding="0 16px 20px">
  <mj-column background-color="#ffffff" border-radius="14px" padding="24px 12px">
    <mj-text
      align="center"
      font-size="28px"
      font-weight="700"
      color="#44476f"
      padding="0 0 8px"
    >
      Order Confirmed!
    </mj-text>
    <mj-text
      align="center"
      font-size="15px"
      line-height="24px"
      color="#555555"
      padding="0 0 18px"
    >
      Thank you for your order, {{ order.customer.firstName }}!
      We have received your order and will process it shortly.
    </mj-text>

    <mj-table
      width="100%"
      padding="0"
      cellpadding="0"
      font-size="12px"
      color="#777777"
    >
      <tr>
        <td align="center" style="background-color: #f7f5fa;">
          <strong>ORDER NUMBER</strong><br />
          <span style="font-size: 15px; color: #44476f;">#{{ order.code }}</span>
        </td>
        <td align="center" style="background-color: #f7f5fa;">
          <strong>ORDER DATE</strong><br />
          <span style="font-size: 15px; color: #44476f;">{{ formatDate order.orderPlacedAt }}</span>
        </td>
        <td align="center" style="background-color: #f7f5fa;">
          <strong>ORDER TOTAL</strong><br />
          <span style="font-size: 15px; font-weight: 700; color: #8465c8;">
            {{ formatMoney order.totalWithTax order.currencyCode 'en' }}
          </span>
        </td>
      </tr>
    </mj-table>

    <mj-divider border-color="#eceaf2" padding="16px 0 8px" />
    <mj-text font-size="20px" font-weight="700" color="#44476f" padding="0 0 8px">
      Shipping Address
    </mj-text>
    <mj-text font-size="15px" line-height="24px" color="#555555" padding="0">
      {{#with order.shippingAddress }}
        <strong>{{ fullName }}</strong><br />
        {{#if company}}
          {{ company }}<br />
        {{/if}}
        {{#if streetLine1}}
          {{ streetLine1 }}<br />
        {{/if}}
        {{#if streetLine2}}
          {{ streetLine2 }}<br />
        {{/if}}
        {{#if city}}
          {{ city }}
        {{/if}}
        {{#if province}}
          , {{ province }}
        {{/if}}
        {{#if postalCode}}
          - {{ postalCode }}
        {{/if}}
        <br />
        {{#if country}}
          {{ country }}
        {{/if}}
        {{#if phoneNumber}}
          <br />
          Phone: {{ phoneNumber }}
        {{/if}}
      {{/with}}
    </mj-text>

    <mj-divider border-color="#eceaf2" padding="16px 0 8px" />
    <mj-text font-size="20px" font-weight="700" color="#44476f" padding="0 0 8px">
      Order Summary
    </mj-text>
   <mj-table
      width="100%"
      padding="0"
      table-layout="fixed"
      cellpadding="0"
      font-family="Helvetica, Arial, sans-serif"
      font-size="11px"
      color="#444444"
    >
      <tr style="border-bottom: 2px solid #eeeeee;">
        <th align="left" style="width: 62%; padding: 4px 3px; color: #777777;">Product</th>
        <th align="center" style="width: 12%; padding: 4px 2px; color: #777777; white-space: nowrap;">Qty</th>
        <th align="right" style="width: 26%; padding: 4px 2px; color: #777777; white-space: nowrap;">Price</th>
      </tr>
      {{#each order.lines }}
        <tr style="border-bottom: 1px solid #eeeeee;">
          <td style="width: 62%; padding: 6px 3px; white-space: normal; word-break: normal; overflow-wrap: break-word;">
            <strong>{{ productVariant.name }}</strong>
          </td>
          <td align="center" style="width: 12%; padding: 6px 2px; white-space: nowrap;">{{ quantity }}</td>
          <td align="right" style="width: 26%; padding: 6px 2px; font-size: 10px; font-weight: 600; white-space: nowrap;">
            {{ formatMoney discountedLinePriceWithTax ../order.currencyCode 'en' }}
          </td>
        </tr>
      {{/each}}
      {{#each order.discounts }}
        <tr style="border-bottom: 1px solid #eeeeee;">
          <td colspan="2" style="padding: 6px 3px; color: #555555;">
            Discount: {{ description }}
          </td>
          <td align="right" style="padding: 6px 2px; font-size: 10px; white-space: nowrap;">
            {{ formatMoney amount ../order.currencyCode 'en' }}
          </td>
        </tr>
      {{/each}}
    </mj-table>

    <mj-divider border-color="#eceaf2" padding="16px 0 8px" />
    <mj-text font-size="20px" font-weight="700" color="#44476f" padding="0 0 8px">
      Payment Summary
    </mj-text>
    <mj-table
      width="100%"
      padding="0"
      cellpadding="6px"
      font-family="Helvetica, Arial, sans-serif"
      font-size="14px"
      color="#555555"
    >
      <tr>
        <td style="padding: 6px 0;">Subtotal</td>
        <td align="right" style="padding: 6px 0;">
          {{ formatMoney order.subTotalWithTax order.currencyCode 'en' }}
        </td>
      </tr>
      {{#each shippingLines }}
        <tr>
          <td style="padding: 6px 0;">Shipping ({{ shippingMethod.name }})</td>
          <td align="right" style="padding: 6px 0;">
            {{ formatMoney priceWithTax ../order.currencyCode 'en' }}
          </td>
        </tr>
      {{/each}}
      <tr style="border-top: 2px solid #eeeeee;">
        <td style="padding: 14px 0 6px; font-size: 17px; font-weight: 700; color: #44476f;">
          Total
        </td>
        <td align="right" style="padding: 14px 0 6px; font-size: 17px; font-weight: 700; color: #8465c8;">
          {{ formatMoney order.totalWithTax order.currencyCode 'en' }}
        </td>
      </tr>
    </mj-table>

    <mj-text
      align="center"
      font-size="14px"
      line-height="22px"
      color="#777777"
      padding="20px 0 0"
    >
      Thank you for shopping with <strong>PetsUpRight</strong>!
      <br />
      We will keep you updated about your order.
    </mj-text>
  </mj-column>
</mj-section>

{{> footer }}
