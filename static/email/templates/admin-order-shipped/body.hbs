{{> header title="Order shipped" previewOrderCode=order.code previewPrefix="Order " previewSuffix=" has shipped." }}

<mj-section background-color="#f7f5fa" padding="0 16px 20px">
  <mj-column background-color="#ffffff" border-radius="14px" padding="24px">
    <mj-text align="center" color="#44476f" font-size="24px" font-weight="700" padding="0 0 12px">
      Shipment is on its way
    </mj-text>
    <mj-text align="center">
      Order <strong>#{{order.code}}</strong> has shipped.
    </mj-text>
    <mj-divider border-color="#eceaf2" padding="8px 0" />
    <mj-text><strong>Courier:</strong> {{fulfillment.courierName}}</mj-text>
    <mj-text><strong>Tracking / AWB:</strong><br />{{fulfillment.trackingCode}}</mj-text>
  </mj-column>
</mj-section>

{{> footer }}
