{{> header title="Reset your password" preheader="Use the link inside to choose a new PetsUpRight password." }}

<mj-wrapper background-color="#ffffff" border-radius="16px" padding="32px 20px 28px">
  <mj-section>
    <mj-column>
      <mj-text align="center" css-class="h1" font-size="26px" line-height="34px" font-weight="700" color="#2f3150">
        Reset your password
      </mj-text>
      <mj-text align="center" padding="12px 0 0" color="#5b5d78">
        We received a request to reset the password for your PetsUpRight account. Click below to choose a new one.
      </mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="24px 0 0">
    <mj-column>
      <mj-button href="{{ passwordResetUrl }}?token={{ passwordResetToken }}" css-class="btn-full">
        Reset password
      </mj-button>
      <mj-text align="center" padding="16px 0 0" font-size="13px" line-height="20px" color="#7b7d94">
        If you didn't ask for this, you can ignore this email - your password won't change.
      </mj-text>
    </mj-column>
  </mj-section>
</mj-wrapper>

{{> footer }}
