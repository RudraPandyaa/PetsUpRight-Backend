{{> header title="Your order is on its way" previewOrderCode=order.code previewPrefix="Order " previewSuffix=" has shipped." }}

<mj-section background-color="#f7f5fa" padding="0 16px 20px">
  <mj-column background-color="#ffffff" border-radius="14px" padding="24px">
    <mj-text align="center" color="#44476f" font-size="25px" font-weight="700" padding="0 0 8px">
      Your order is on its way!
    </mj-text>
    <mj-text align="center">
      Order <strong>#{{order.code}}</strong> has shipped.
    </mj-text>
    <mj-divider border-color="#eceaf2" padding="8px 0" />
    <mj-table cellpadding="8px" font-size="13px" color="#44476f">
      <tr>
        <td align="center" style="background-color: #f7f5fa;">
          <strong>SHIPMENT STATUS</strong><br />
          SHIPPED
        </td>
        <td align="center" style="background-color: #f7f5fa;">
          <strong>COURIER</strong><br />
          {{fulfillment.customFields.shiprocketCourierName}}
        </td>
      </tr>
    </mj-table>
    <mj-text padding="18px 0 4px" font-weight="700" color="#44476f">
      TRACKING / AWB
    </mj-text>
    <mj-text background-color="#f7f5fa" padding="14px">
      {{fulfillment.trackingCode}}
    </mj-text>
    <mj-text align="center" color="#77778a" font-size="13px" padding="12px 0 0">
      Thank you for shopping with PetsUpRight.
    </mj-text>
  </mj-column>
</mj-section>

{{> footer }}
