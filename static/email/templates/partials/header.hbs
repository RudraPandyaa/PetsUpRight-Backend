<mjml>
  <mj-head>
    <mj-title>{{title}}</mj-title>
    {{#if previewOrderCode}}
      <mj-preview>{{previewPrefix}}#{{previewOrderCode}}{{previewSuffix}}</mj-preview>
    {{/if}}
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="#55566f" font-size="14px" line-height="1.6" />
      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#f7f5fa" width="600px">
    <mj-section background-color="#f7f5fa" padding="18px 16px 10px">
      <mj-column>
        <mj-image
          src="{{emailLogoUrl}}"
          alt="PetsUpRight"
          width="150px"
          align="center"
          padding="0"
        />
      </mj-column>
    </mj-section>
