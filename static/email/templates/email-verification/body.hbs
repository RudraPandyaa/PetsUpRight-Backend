{{> header title="Verify Your Email Address" }}

<mj-section background-color="#f7f5fa" padding="0 16px 20px">
  <mj-column background-color="#ffffff" border-radius="14px" padding="24px">
    <mj-text
      align="center"
      font-size="28px"
      font-weight="700"
      color="#44476f"
      padding="0 0 10px"
    >
      Verify Your Email
    </mj-text>
    <mj-text
      align="center"
      font-size="16px"
      line-height="26px"
      color="#555555"
      padding="0 0 16px"
    >
      Thank you for creating an account with PetsUpRight!
      Please verify your email address to complete your registration.
    </mj-text>
    <mj-text
      align="center"
      font-size="14px"
      line-height="22px"
      color="#8465c8"
      font-weight="700"
      padding="0 0 16px"
    >
      This verification link is valid for 1 hour only.
      Please verify your email within 1 hour.
    </mj-text>
    <mj-button
      font-size="16px"
      font-weight="700"
      background-color="#8465c8"
      color="#ffffff"
      border-radius="8px"
      padding="8px 0 20px"
      href="{{ verifyEmailAddressUrl }}?token={{ verificationToken }}"
    >
      Verify My Email
    </mj-button>
    <mj-text
      align="center"
      font-size="13px"
      line-height="20px"
      color="#888888"
      padding="0"
    >
      If you did not create an account with PetsUpRight,
      you can safely ignore this email.
    </mj-text>
  </mj-column>
</mj-section>

{{> footer }}
