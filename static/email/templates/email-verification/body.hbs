{{> header title="Verify your email address" preheader="Confirm your email to finish creating your PetsUpRight account." }}

<mj-wrapper background-color="#ffffff" border-radius="16px" padding="32px 20px 28px">
  <mj-section>
    <mj-column>
      <mj-text align="center" css-class="h1" font-size="26px" line-height="34px" font-weight="700" color="#2f3150">
        Verify your email
      </mj-text>
      <mj-text align="center" padding="12px 0 0" color="#5b5d78">
        Thanks for creating a PetsUpRight account! Please confirm your email address to finish signing up.
      </mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="24px 0 0">
    <mj-column>
      <mj-button href="{{ verifyEmailAddressUrl }}?token={{ verificationToken }}" css-class="btn-full">
        Verify my email
      </mj-button>
      <mj-text align="center" padding="16px 0 0" font-size="13px" line-height="20px" color="#8465c8" font-weight="600">
        This link is valid for 1 hour.
      </mj-text>
      <mj-text align="center" padding="14px 0 0" font-size="13px" line-height="20px" color="#7b7d94">
        If you didn't create an account with PetsUpRight, you can safely ignore this email.
      </mj-text>
    </mj-column>
  </mj-section>
</mj-wrapper>

{{> footer }}
