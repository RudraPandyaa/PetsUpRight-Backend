<mjml>
    <mj-head>
        <mj-title>Order delivered</mj-title>
        <mj-preview>Order #{{order.code}} has been delivered.</mj-preview>
    </mj-head>
    <mj-body background-color="#f7f5fa" width="600px">
        <mj-section background-color="#ffffff" padding="24px">
            <mj-column>
                <mj-image src="{{emailLogoUrl}}" alt="PetsUpRight logo" width="120px" align="center" padding="0" />
            </mj-column>
        </mj-section>
        <mj-section padding="20px">
            <mj-column background-color="#ffffff" border-radius="16px" padding="28px">
                <mj-text align="center" color="#32805a" font-size="24px" font-weight="700">
                    Order delivered
                </mj-text>
                <mj-text align="center">
                    Order <strong>#{{order.code}}</strong> has been delivered.
                </mj-text>
                <mj-divider border-color="#eceaf2" />
                <mj-text><strong>Courier:</strong> {{fulfillment.courierName}}</mj-text>
                <mj-text><strong>Tracking / AWB:</strong><br />{{fulfillment.trackingCode}}</mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>