{{> header title=heading preheader=preheader }}

<mj-wrapper background-color="#ffffff" border-radius="16px" padding="28px 20px 26px">
  {{#if isPreview}}
    <mj-section padding="0 0 14px">
      <mj-column background-color="#fff6e5" border-radius="8px" padding="8px 12px">
        <mj-text align="center" font-size="12px" line-height="18px" color="#8a5a00">
          Preview: this is the email a customer receives at this step.
        </mj-text>
      </mj-column>
    </mj-section>
  {{/if}}

  <mj-section>
    <mj-column>
      <mj-text align="center" css-class="h1" font-size="26px" line-height="34px" font-weight="700" color="#2f3150">
        {{heading}}
      </mj-text>
      <mj-text align="center" padding="10px 0 0" color="#5b5d78">
        {{intro}}
      </mj-text>
      {{#if refundNote}}
        <mj-text align="center" padding="12px 0 0" font-size="14px" line-height="22px" color="#7b7d94">
          {{refundNote}}
        </mj-text>
      {{/if}}
    </mj-column>
  </mj-section>

  {{#if tracker}}
    {{> tracker steps=tracker }}
  {{/if}}

  {{#unless isCancelled}}
    {{> shipment }}
  {{/unless}}

  <mj-section padding="24px 0 0">
    <mj-column>
      <mj-button href="{{cta.url}}" css-class="btn-full">{{cta.label}}</mj-button>
      {{#if secondaryCta}}
        <mj-button href="{{secondaryCta.url}}" background-color="#ffffff" color="#44476f" border="1px solid #44476f" padding="10px 0 0" css-class="btn-full">
          {{secondaryCta.label}}
        </mj-button>
      {{/if}}
    </mj-column>
  </mj-section>

  {{> order-items }}

  <mj-section padding="24px 0 0">
    <mj-column>
      <mj-divider padding="0 0 18px" />
    </mj-column>
  </mj-section>
  <mj-section>
    <mj-column width="50%">
      <mj-text font-size="12px" font-weight="700" color="#7b7d94" letter-spacing="0.6px" padding="0 10px 6px 0">
        DELIVERING TO
      </mj-text>
      <mj-text font-size="14px" line-height="21px" padding="0 10px 0 0">
        <strong style="color: #2f3150;">{{order.address.name}}</strong><br />
        {{#each order.address.lines}}{{this}}<br />{{/each}}
        {{#if order.address.phone}}Phone: {{order.address.phone}}{{/if}}
      </mj-text>
    </mj-column>
    <mj-column width="50%" css-class="stack-gap">
      <mj-text font-size="12px" font-weight="700" color="#7b7d94" letter-spacing="0.6px" padding="0 0 6px">
        ORDER DETAILS
      </mj-text>
      <mj-text font-size="14px" line-height="21px">
        Order no. <strong style="color: #2f3150;">#{{order.code}}</strong><br />
        Placed on {{order.date}}<br />
        {{#if order.paymentMethod}}{{order.paymentMethod}}<br />{{/if}}
        Delivery: {{order.deliveryType}}
      </mj-text>
    </mj-column>
  </mj-section>
</mj-wrapper>

{{> footer }}
